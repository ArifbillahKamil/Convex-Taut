# Convex CLI creates these public client values in .env.local.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Put private keys in .env.secrets.local, never in VITE_ variables.
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
# Optional: use your account's documented regional API endpoint.
AGENTMAIL_BASE_URL=https://api.agentmail.to/v0
